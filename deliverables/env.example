# Lab values for the compose file. Not a production secret store.
# MYSQL_IMAGE is a variable on purpose. Pin a Docker Official Image tag
# you have checked. Check upstream docs. Do not use a tag named latest.
MYSQL_IMAGE=mysql:CHECK_UPSTREAM_DOCS
MYSQL_ROOT_PASSWORD=lab-root-change-me
MYSQL_DATABASE=laborders
REPL_USER=labrepl
REPL_PASSWORD=lab-repl-change-me
PRIMARY_PORT=13306
REPLICA_PORT=13307
