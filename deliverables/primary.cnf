# Lab primary option file. Not a production configuration.
# Names are MySQL server options. Hyphens and underscores are
# interchangeable in option files. Check upstream docs for your version.

[mysqld]
server_id=1
log_bin=mysql-bin
binlog_format=ROW
gtid_mode=ON
enforce_gtid_consistency=ON
# Container listen address so the replica on the compose network can connect.
# The compose file publishes the host port on 127.0.0.1 only.
bind-address=0.0.0.0
